# Copie para .env (NUNCA versione o .env). Em produção estes valores ficam no servidor / secrets do GitHub.

# Banco
DB_PASSWORD=troque

# JWT: no mínimo 32 caracteres aleatórios (ex.: openssl rand -base64 48)
JWT_SECRET=

# Administrador da plataforma (criado no boot; senha com 12+ caracteres). As lojas se cadastram pelo app.
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Chave dos segredos cifrados no banco (verificação em duas etapas). Vazio = derivada do JWT_SECRET.
# Ex.: openssl rand -base64 48
APP_ENCRYPTION_KEY=

# Endereço público da API (HTTPS em produção)
APP_PUBLIC_URL=https://api.lojamax.com.br
CORS_ORIGINS=https://lojamax.com.br

# Fotos dos produtos no Cloudflare R2 (as cinco juntas; faltando uma, grava no disco)
R2_BUCKET=
R2_ENDPOINT=https://SEU_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# Push (Firebase): saída de `base64 -w0 conta-de-servico.json`
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# E-mail de recuperação de senha (https://resend.com)
RESEND_API_KEY=
MAIL_FROM=Loja Max <nao-responda@lojamax.com.br>
