# /opt/loja-max/.env no servidor — NUNCA versione o arquivo preenchido.

POSTGRES_PASSWORD=          # openssl rand -base64 24
JWT_SECRET=                 # openssl rand -base64 48
APP_ENCRYPTION_KEY=         # openssl rand -base64 48 (segredos da verificação em duas etapas)

APP_PUBLIC_URL=https://lojamax.focodev.com.br
CORS_ORIGINS=https://lojamax.focodev.com.br
HTTP_PORT=8090

# Administrador da plataforma (senha com 12+ caracteres)
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Páginas de privacidade/termos
LEGAL_COMPANY=Loja Max
LEGAL_EMAIL=contato@lojamax.com.br

# Fotos dos produtos (Cloudflare R2) — docs/FOTOS_R2.md
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Backup fora do servidor: bucket PRIVADO do R2 (opcional)
BACKUP_BUCKET=

# Push (Firebase): base64 -w0 conta-de-servico.json — docs/PUSH.md
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=

# E-mail de recuperação de senha (Resend)
RESEND_API_KEY=
MAIL_FROM=Loja Max <nao-responda@lojamax.focodev.com.br>

# Assinatura do entregador (R$ 24,99/mês depois de 5 entregas grátis): chave Pix da plataforma mostrada no app
BILLING_PIX_KEY=
BILLING_PIX_HOLDER=
